{
  "name": "playwright-typescript-portfolio-toolshop",
  "version": "1.0.0",
  "description": "QA automation portfolio: Playwright and TypeScript tests (UI, API, E2E) for the Practice Software Testing Toolshop.",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,mjs,json}\"",
    "format:check": "prettier --check \"**/*.{ts,mjs,json}\"",
    "typecheck": "tsc --noEmit",
    "test": "playwright test --project=api --project=chromium",
    "test:all": "playwright test",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test tests/ui --project=chromium",
    "test:e2e": "playwright test tests/e2e --project=chromium",
    "test:smoke": "playwright test --grep @smoke --project=api --project=chromium",
    "report": "playwright show-report"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ggaj3cki/playwright-typescript-portfolio-toolshop.git"
  },
  "keywords": [
    "playwright",
    "typescript",
    "test-automation",
    "qa",
    "api-testing",
    "e2e-testing",
    "page-object-model"
  ],
  "author": "ggaj3cki",
  "license": "ISC",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
